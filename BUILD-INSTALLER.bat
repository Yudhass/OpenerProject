@echo off
setlocal EnableDelayedExpansion
title BUILD PY TO INSTALLER - Project IDE Opener
color 0A

REM ===== CONFIG =====
set "APP_NAME=Project IDE Opener"
set "APP_VERSION=2.0 Modern"
set "EXE_NAME=ProjectIDEOpener.exe"
set "SETUP_NAME=ProjectIDEOpener-Setup-v2.0.exe"
set "LOGFILE=build.log"
set "START_TIME=%TIME%"

REM Bersihkan log lama
echo [%DATE% %TIME%] ===== BUILD START ===== > "%LOGFILE%"
echo [%DATE% %TIME%] APP: %APP_NAME% v%APP_VERSION% >> "%LOGFILE%"

call :LOG "INFO" "==================================================="
call :LOG "INFO" "  BUILD PY TO EXE TO INSTALLER (1-Click)"
call :LOG "INFO" "  %APP_NAME% v%APP_VERSION%"
call :LOG "INFO" "==================================================="
echo.

REM ===== STEP 0: Cek Python & PyInstaller =====
call :LOG "STEP" "[0/4] Mengecek environment..."

python --version >nul 2>&1
if %errorlevel% neq 0 (
    call :LOG "ERROR" "Python tidak ditemukan! Install dari https://python.org (centang Add to PATH)"
    pause & exit /b 1
)
for /f "delims=" %%v in ('python --version 2^>^&1') do set PYVER=%%v
call :LOG "OK" "Python: !PYVER!"

pyinstaller --version >nul 2>&1
if %errorlevel% neq 0 (
    call :LOG "WARN" "PyInstaller belum ada, menginstall..."
    pip install pyinstaller >> "%LOGFILE%" 2>&1
    if !errorlevel! neq 0 (
        call :LOG "ERROR" "Gagal install PyInstaller"
        pause & exit /b 1
    )
)
for /f "delims=" %%v in ('pyinstaller --version 2^>^&1') do set PIVER=%%v
call :LOG "OK" "PyInstaller: !PIVER!"
echo.

REM ===== STEP 1: Build EXE (PyInstaller) =====
call :LOG "STEP" "[1/4] Building EXE dari main.py (PyInstaller)..."
call :LOG "INFO" "  Command: pyinstaller --onefile --windowed --icon=logo.ico --name ProjectIDEOpener main.py"
echo [%DATE% %TIME%] --- PyInstaller log start --- >> "%LOGFILE%"

if exist "logo.ico" (
    pyinstaller --onefile --windowed --name "ProjectIDEOpener" --icon=logo.ico --add-data "logo.ico;." --add-data "logo.png;." --clean main.py >> "%LOGFILE%" 2>&1
) else (
    pyinstaller --onefile --windowed --name "ProjectIDEOpener" --clean main.py >> "%LOGFILE%" 2>&1
)
echo [%DATE% %TIME%] --- PyInstaller log end --- >> "%LOGFILE%"

if not exist "dist\%EXE_NAME%" (
    call :LOG "ERROR" "Build EXE GAGAL! Cek build.log dan main.py"
    pause & exit /b 1
)
for %%F in ("dist\%EXE_NAME%") do set EXESIZE=%%~zF
set /a EXESIZEMB=!EXESIZE!/1024/1024
call :LOG "OK" "EXE jadi: dist\%EXE_NAME% (!EXESIZEMB! MB, !EXESIZE! bytes)"
echo.

REM ===== STEP 2: Generate installer.iss (jika belum ada) =====
call :LOG "STEP" "[2/4] Menyiapkan installer.iss..."
if exist "installer.iss" (
    call :LOG "INFO" "  installer.iss sudah ada, pakai yang ada"
) else (
    call :LOG "INFO" "  Membuat installer.iss baru..."
    (
    echo ; Auto-generated by BUILD-INSTALLER.bat
    echo #define MyAppName "Project IDE Opener"
    echo #define MyAppVersion "2.0 Modern"
    echo #define MyAppPublisher "Yudha Pratama"
    echo #define MyAppURL "https://github.com/yudha/opener"
    echo #define MyAppExeName "ProjectIDEOpener.exe"
    echo [Setup]
    echo AppId={{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}
    echo AppName={#MyAppName}
    echo AppVersion={#MyAppVersion}
    echo AppPublisher={#MyAppPublisher}
    echo DefaultDirName={autopf}\{#MyAppName}
    echo DefaultGroupName={#MyAppName}
    echo OutputDir=dist
    echo OutputBaseFilename=ProjectIDEOpener-Setup-v2.0
    echo Compression=lzma
    echo SolidCompression=yes
    echo WizardStyle=modern
    echo SetupIconFile=logo.ico
    echo UninstallDisplayIcon={app}\{#MyAppExeName}
    echo ArchitecturesInstallIn64BitMode=x64os
    echo PrivilegesRequired=lowest
    echo CloseApplications=yes
    echo [Languages]
    echo Name: "english"; MessagesFile: "compiler:Default.isl"
    echo Name: "indonesian"; MessagesFile: "compiler:Default.isl"
    echo [Tasks]
    echo Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
    echo [Files]
    echo Source: "dist\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
    echo Source: "logo.ico"; DestDir: "{app}"; Flags: ignoreversion
    echo Source: "logo.png"; DestDir: "{app}"; Flags: ignoreversion
    echo [Icons]
    echo Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\logo.ico"
    echo Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
    echo Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; IconFilename: "{app}\logo.ico"
    echo [Run]
    echo Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
    echo [UninstallDelete]
    echo Type: filesandordirs; Name: "{app}\__pycache__"
    echo Type: files; Name: "{app}\app.log"
    ) > "installer.iss"
    call :LOG "OK" "  installer.iss dibuat"
)
echo.

REM ===== STEP 3: Cek / Install Inno Setup =====
call :LOG "STEP" "[3/4] Mengecek Inno Setup Compiler (ISCC.exe)..."
set "ISCC=C:\Program Files (x86)\Inno Setup 6\ISCC.exe"
if exist "%ISCC%" (
    call :LOG "OK" "Inno Setup ditemukan: %ISCC%"
    goto COMPILE
)

call :LOG "WARN" "Inno Setup belum terinstall, download otomatis..."
call :LOG "INFO" "  URL: https://github.com/jrsoftware/issrc/releases/download/is-6_7_3/innosetup-6.7.3.exe"
set "INNO_TMP=%TEMP%\is6setup.exe"
call :LOG "INFO" "  Download ke: %INNO_TMP%"

powershell -Command "try { Invoke-WebRequest -Uri 'https://github.com/jrsoftware/issrc/releases/download/is-6_7_3/innosetup-6.7.3.exe' -OutFile '%INNO_TMP%' -UseBasicParsing; exit 0 } catch { Write-Host $_.Exception.Message; exit 1 }" >> "%LOGFILE%" 2>&1
if not exist "%INNO_TMP%" (
    call :LOG "ERROR" "Download gagal! Cek internet atau download manual: https://jrsoftware.org/isdl.php"
    pause & exit /b 1
)
for %%F in ("%INNO_TMP%") do set DLMB=%%~zF
set /a DLMB=!DLMB!/1024/1024
call :LOG "OK" "Download selesai (!DLMB! MB), install silent..."

"%INNO_TMP%" /SP- /VERYSILENT /SUPPRESSMSGBOXES /NORESTART >> "%LOGFILE%" 2>&1
timeout /t 5 >nul

if not exist "%ISCC%" (
    call :LOG "ERROR" "Install Inno Setup gagal! Coba manual: https://jrsoftware.org/isdl.php"
    pause & exit /b 1
)
call :LOG "OK" "Inno Setup terinstall: %ISCC%"

:COMPILE
echo.
call :LOG "STEP" "[4/4] Compile installer.iss -> Setup.exe (ISCC)"
echo [%DATE% %TIME%] --- ISCC log start --- >> "%LOGFILE%"
"%ISCC%" "installer.iss" >> "%LOGFILE%" 2>&1
set ISCC_ERR=%errorlevel%
echo [%DATE% %TIME%] --- ISCC log end (exit=%ISCC_ERR%) --- >> "%LOGFILE%"

if %ISCC_ERR% neq 0 (
    call :LOG "ERROR" "Compile installer GAGAL! Cek build.log"
    pause & exit /b 1
)

if not exist "dist\%SETUP_NAME%" (
    call :LOG "ERROR" "Setup.exe tidak ditemukan setelah compile!"
    pause & exit /b 1
)

for %%F in ("dist\%SETUP_NAME%") do set SETUPSIZE=%%~zF
set /a SETUPSIZEMB=!SETUPSIZE!/1024/1024
call :LOG "OK" "Installer jadi: dist\%SETUP_NAME% (!SETUPSIZEMB! MB, !SETUPSIZE! bytes)"
echo.

REM ===== SUMMARY =====
call :LOG "INFO" "==================================================="
call :LOG "INFO" "  BUILD SELESAI - SEMUA TAHAPAN SUKSES"
call :LOG "INFO" "==================================================="
call :LOG "INFO" "  1. main.py --PyInstaller-- dist\%EXE_NAME% (!EXESIZEMB! MB)"
call :LOG "INFO" "  2. installer.iss --ISCC-- dist\%SETUP_NAME% (!SETUPSIZEMB! MB)"
call :LOG "INFO" "  Log lengkap: build.log"
call :LOG "INFO" "  Durasi: %START_TIME% -> %TIME%"
echo.
echo File di dist:
dir dist\*.exe | findstr /i "ProjectIDEOpener"
echo.
echo Cara install:
echo   Double-klik dist\%SETUP_NAME% - Next-Next-Finish
echo   Start Menu + Desktop shortcut (opsional)
echo   Uninstall via Settings - Apps
echo.
choice /M "Buka folder dist"
if %errorlevel% equ 1 explorer dist
pause
exit /b 0

:LOG
set "LVL=%~1"
set "MSG=%~2"
echo [%TIME:~0,8%] [%LVL%] %MSG%
echo [%DATE% %TIME%] [%LVL%] %MSG% >> "%LOGFILE%"
exit /b 0
